<?xml version="1.0"?>
<ruleset name="Tutor LMS Instructor Offline Payment">
	<description>Coding standard for the Tutor LMS Instructor Offline Payment plugin.</description>

	<!-- What to scan. -->
	<file>.</file>

	<!-- Show sniff codes, show progress, use 8 parallel processes. -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>

	<!-- Skip anything that isn't ours or isn't PHP we wrote. -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<!-- Core ruleset: WordPress-Extra (includes WordPress-Core) plus docs. -->
	<rule ref="WordPress-Extra">
		<!-- The codebase intentionally uses direct $wpdb queries for the custom
		     order-meta joins Tutor's own models don't expose; every query is
		     prepared and each occurrence already carries an inline
		     phpcs:ignore with its own justification, so this category is left
		     enabled and enforced per-line rather than disabled wholesale. -->
	</rule>
	<rule ref="WordPress-Docs"/>

	<!-- This plugin's one text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="tutor-instructor-offline-payment"/>
			</property>
		</properties>
	</rule>

	<!-- Prefix used for functions, hooks, options, meta keys and globals. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="tioc"/>
				<element value="TIOC"/>
				<element value="TutorInstructorOfflinePayment"/>
			</property>
		</properties>
	</rule>

	<!-- Support policy: PHP 7.4+ (see the plugin header). -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Minimum WP version this plugin declares support for. -->
	<config name="minimum_supported_wp_version" value="6.0"/>

	<!-- Namespaced classes under includes/ don't take the file-level "class-"
	     naming sniff literally the way procedural includes do; the file names
	     already follow WP's class-file convention (class-orders.php etc.). -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>
</ruleset>
